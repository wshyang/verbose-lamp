# Copy to .env before running `npm run dev`. Never commit a real .env (see .gitignore).

# --- API ---
NODE_ENV=development
PORT=8787

# The driver follows DATABASE_URL (ADR-051): set it and the app talks to that server, leave it
# unset and the whole database lives in ./.data/dev as embedded PGlite, with nothing to install.
#
# For a real Postgres locally:
#   docker compose -f docker-compose.db.yml up -d
#   DATABASE_URL=postgresql://psd:psd@127.0.0.1:5432/psd_active_day
# A managed provider works the same way; `pg` handles sslmode itself:
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# An empty database is provisioned from schema.sql on first boot — there is no migration step.
PGLITE_DATA_DIR=.data/dev
# DATABASE_URL=postgresql://psd:psd@127.0.0.1:5432/psd_active_day
#
# MANAGED DATABASES (ADR-178): if the role in DATABASE_URL cannot create objects in schema
# public — the PostgreSQL 15 default for anyone who is not the database owner — the app cannot
# provision itself and will refuse to boot, naming the remedy. Either grant it the right:
#   GRANT USAGE, CREATE ON SCHEMA public TO "your_role";
# or build the schema from a machine holding an admin credential and let the app only verify it:
#   ./db-provision.sh 'postgresql://ADMIN:...@host/db' --grant-to 'postgresql://APP:...@host/db'
# `--inspect` answers which case you are in and writes nothing. Pass --grant-to on EVERY
# provisioning run: tables belong to whoever built them, and where the admin credential is a
# rotating just-in-time role, default privileges from the last run do not cover this one's work.
#
# DB_INIT (ADR-249): provision DATABASE_URL's database before the server starts.
#   schema  schema.sql + the default seed (superadmin, clusters, titles)
#   demo    that, plus the recorded demo day (runs ./db-provision.sh --demo; needs bash)
# Leave unset for the usual self-provisioning boot. The demo day only lands in a database with no
# participants, so restarting with DB_INIT=demo cannot double the crowd.
# DB_INIT=schema
#
# DATABASE_URL_ADMIN (ADR-252): a more privileged connection string used ONLY for the DB_INIT step.
# When present it overrides DATABASE_URL for provisioning — the schema, the seed and the demo day are
# built as this role — and the role in DATABASE_URL is then GRANTED read/write on what was built and
# checked for it. The running app still connects as DATABASE_URL, so it can hold the least privilege
# that works. Needs DB_INIT; ignored (with a warning in the boot log) without it.
# DATABASE_URL_ADMIN=postgresql://admin:...@host/db?sslmode=require
#
# DATABASE_DRIVER is intentionally NOT set here. Setting it overrides the inference above, which is
# only wanted when forcing PGlite despite a DATABASE_URL being present.
# DATABASE_DRIVER=pglite

# B1 bootstrap: migrations FAIL LOUDLY if this is unset (fds.md §10 B1).
# There is no default and no fallback — a silent well-known passcode is worse than a crash.
SUPERADMIN_INITIAL_USERNAME=superadmin
SUPERADMIN_INITIAL_PASSCODE=4242

# Cookie sessions last the whole event; set COOKIE_SECURE=true behind HTTPS.
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Where the app is served matters (ADR-015). Served as its own page, Lax is correct.
# Served INSIDE another site — a preview iframe, an intranet portal — the browser treats the
# cookie as cross-site and silently drops it, so sign-in appears to do nothing at all. For
# that deployment use all three, over HTTPS:
#   COOKIE_SAMESITE=None
#   COOKIE_SECURE=true
#   COOKIE_PARTITIONED=true
# The API refuses to start on None-without-Secure rather than ship a cookie browsers ignore.
COOKIE_SAMESITE=Lax
COOKIE_PARTITIONED=false

# Logs which credential carrier each API request arrived with (cookie / header /
# authorization / query) and the status it got — presence only, never the token. Turn this on
# when sign-in works locally but not through a proxy you do not control.
LOG_AUTH_CARRIER=false

# --- Web ---
# The Vite dev server proxies /api to this origin; browser code only ever uses relative URLs.
PSD_API_TARGET=http://127.0.0.1:8787

# --- Data tiers (ADR-102) ---
# Which data tier a FRESH database gets beyond the always-applied default seed
# (schema.sql + seed-default.sql: the initial superadmin and the named facilitators).
#   default  — the usual: an empty event, ready for bootstrap (fds.md §8.1).
#   demo     — additionally applies seed-demo.sql, a full recorded demo day (80 participants,
#              a live tournament, chat, photo wall). Applied once, never into a database that
#              already holds participants. Regenerate the file with `npm run db:export-demo`.
PSD_SEED=default

# ADR-295 — which venue this deployment runs at: the palette, motifs and scene the participant app
# wears. Must be one of VENUE_IDS in packages/contracts/src/venue.ts (today: sentosa). An unknown
# value stops the server at boot. Changing it needs a restart; every phone picks it up on its next
# page load.
PSD_VENUE=sentosa
