{
  "name": "kallang-active-day",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "serve:dist": "serve dist -l 3000",
    "test": "vitest run tests/unit",
    "test:py": "python3 -m pytest tests/python -q",
    "test:e2e": "playwright test",
    "qa:lab": "tsx qa/renderLab.ts",
    "qa:scene": "tsx qa/renderScene.ts",
    "assets:organise": "python3 tools/organise_sources.py",
    "assets:extract": "python3 tools/extract_sprites.py",
    "assets:contact": "python3 tools/contact_sheet.py",
    "qa:gait": "tsx qa/renderGait.ts",
    "assets:backdrops": "python3 tools/prepare_backdrops.py",
    "assets:recolour": "python3 tools/recolour_sprites.py"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.5",
    "serve": "^14.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
