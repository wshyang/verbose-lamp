# DEPLOY — `runtime-test`, `deploy-to-testing` and `deploy-to-production`. INERT DRAFT.
#
# Two jobs here are contractual, not stylistic:
#   * `deploy-testing-job` — the E2E template's testing deploy (docs:
#     tools/gitlab/web-app-tutorial.md, checkpoints 9 and 10).
#   * `deploy-final-job` — the production deploy. The template's docs state the name must
#     not change, because the compliance framework's verification jobs
#     (verify-job, verify-artefact-signature, scan-verified-job) are inserted around it and
#     reach `deploy-to-prod` on its success.
#
# What "deploy" means for this app: one image, one container, `docker load` + `docker run`.
# No compose file, no manifest, and the runtime configuration arrives as environment
# variables, which is why the env file on the host matters more than anything in this file.
# Nothing in this repo deploys today (ADR-052), so this is the first written proposal —
# CONFIRM the target hosts and the secret names with whoever runs the environment.

# The suite the repo already has, run against the container rather than against the dev
# stack. This is the "runtime test" IM8 asks for, and it costs nothing new to maintain
# because these are the same specs `npm run test:e2e` runs locally.
webapp-e2e-job:
  stage: runtime-test
  needs: ["deploy-testing-job"]
  # CONFIRM: a prebuilt image carrying the Playwright browsers. `npm run e2e:install`
  # cannot be used here — the shared runners have no egress to the Playwright CDN, so the
  # browsers must come from the image (build it once on a machine with egress, push it to
  # the project's Nexus docker proxy, reference it here).
  image: "$E2E_IMAGE"
  tags:
    - "@@RUNNER_TAG_TOOLING@@"
  variables:
    # PSD_E2E_BASE_URL is the single knob the config honours for a remote target;
    # PSD_E2E_NO_SERVER stops Playwright from starting `npm run dev` next to itself
    # (playwright.config.ts:162). Video off keeps the artefact small; Chromium only, since
    # the WebKit engine belongs on a machine that fetched its browsers.
    PSD_E2E_BASE_URL: "$TESTING_URL"
    PSD_E2E_NO_SERVER: "1"
    PSD_E2E_VIDEO: "off"
    PSD_E2E_ENGINES: "chromium"
  script:
    - npm ci --no-audit --no-fund
    - |
      curl --fail --silent --show-error --max-time 10 "$TESTING_URL$READINESS_PATH" \
        || { echo "testing environment is not answering at $TESTING_URL$READINESS_PATH" >&2; exit 1; }
    - npm run test:e2e:chromium
  artifacts:
    when: on_failure
    paths:
      - test-results/
      - playwright-report/
    expire_in: "1 week"
  rules:
    # Only after something was actually deployed to testing, and never on an MR: the specs
    # write real rows through the app's own APIs, so they belong on an ephemeral testing
    # box and not on whatever a merge request happens to point at.
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'

.deploy-over-ssh: &deploy-over-ssh
  tags:
    - "@@RUNNER_TAG_DEPLOY@@"
  # The SSH private key is fetched from AWS Secrets Manager using the runner's OIDC token,
  # which is the documented way to reach an agency environment without a long-lived
  # credential (templates/gitlab-ci-aws.yml, "invoke-awssecretretrieval"). `id_tokens` is
  # what makes that possible from a job.
  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: "@@OIDC_AUDIENCE@@"
  image: "$DEPLOY_IMAGE"
  before_script:
    - |
      # Fail here with a sentence, not three jobs later with an exec error: the deploy image
      # has to be built for this job, because a shared runner cannot install packages either.
      for tool in ssh scp curl; do
        command -v "$tool" > /dev/null 2>&1 \
          || { echo "$DEPLOY_IMAGE has no $tool — the deploy image must carry ssh, scp and curl." >&2; exit 1; }
      done
      if [ -n "$AWS_SECRET_ID" ]; then
        command -v aws > /dev/null 2>&1 \
          || { echo "AWS_SECRET_ID is set but this image has no aws CLI." >&2; exit 1; }
      fi
      : "${TARGET_HOST:?TARGET_HOST is empty — answer the host question in shiphats-activate.sh}"
    - mkdir -p ~/.ssh && chmod 700 ~/.ssh
    - |
      if [ -n "$AWS_SECRET_ID" ]; then
        KEY_JSON=$(aws secretsmanager get-secret-value --region "$AWS_REGION" \
          --secret-id "$AWS_SECRET_ID" --query SecretString --output text)
        if [ "$SSH_KEY_NAME" = "raw" ]; then
          printf '%s\n' "$KEY_JSON" > ~/.ssh/id_rsa
        else
          # The secret holds a JSON document. There is no jq or node to rely on inside an
          # arbitrary deploy image, so the field is cut out with sed and its \n escapes are
          # turned back into newlines. Keep the secret as a raw key if you can.
          printf '%s' "$KEY_JSON" \
            | tr ',' '\n' \
            | sed -n 's/.*"'"$SSH_KEY_NAME"'"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/p' \
            | sed 's/\\n/\n/g' > ~/.ssh/id_rsa
        fi
      elif [ -n "$DEPLOY_SSH_KEY" ]; then
        # Fallback: a masked, protected CI variable. Works, but the secret then lives in
        # GitLab; prefer the AWS path above where the platform supports it.
        printf '%s\n' "$DEPLOY_SSH_KEY" > ~/.ssh/id_rsa
      else
        echo "Neither AWS_SECRET_ID nor DEPLOY_SSH_KEY is available to this job." >&2
        exit 1
      fi
    - chmod 600 ~/.ssh/id_rsa
    - ssh-keyscan -H "$TARGET_HOST" >> ~/.ssh/known_hosts 2>/dev/null
  script:
    - ssh -o StrictHostKeyChecking=yes "$DEPLOY_USER@$TARGET_HOST" "mkdir -p '$REMOTE_IMAGE_DIR'"
    - |
      scp -o StrictHostKeyChecking=yes "$CI_PROJECT_DIR/$WORKING_DIR/$OUTPUT_ARTEFACT" \
        "$DEPLOY_USER@$TARGET_HOST:$REMOTE_IMAGE_DIR/$OUTPUT_ARTEFACT"
    # The checksum travels with the file. `docker load` would happily accept a truncated
    # tarball from a partial copy and fail later, at container start, in the dark.
    - |
      ssh -o StrictHostKeyChecking=yes "$DEPLOY_USER@$TARGET_HOST" "
        set -e
        cd '$REMOTE_IMAGE_DIR'
        printf '%s  %s\n' '$(cat "$CI_PROJECT_DIR/$WORKING_DIR/$OUTPUT_ARTEFACT.sha512")' '$OUTPUT_ARTEFACT' | sha512sum -c -
        docker load -i '$OUTPUT_ARTEFACT'
      "
    - |
      ssh -o StrictHostKeyChecking=yes "$DEPLOY_USER@$TARGET_HOST" "
        set -e
        test -f '$REMOTE_ENV_FILE' || { echo 'missing $REMOTE_ENV_FILE on the host' >&2; exit 1; }
        docker rm -f '$CONTAINER_NAME' 2>/dev/null || true
        docker run -d --name '$CONTAINER_NAME' --restart unless-stopped \
          --env-file '$REMOTE_ENV_FILE' $RUN_OPTS '$IMAGE_REF'
      "
    - |
      # Readiness is the app's own answer, not the container's process list: a container can
      # be up with the API still migrating its database, and supervisord will happily keep a
      # restarting app alive for a minute before anything looks wrong from the outside. The
      # check runs on the host because that is where the port is bound.
      ready=""
      for i in $(seq 1 30); do
        if ssh -o StrictHostKeyChecking=yes "$DEPLOY_USER@$TARGET_HOST" \
             "curl -fsS --max-time 5 http://127.0.0.1:$PORT$READINESS_PATH | grep -q '$WEBAPP_NAME'"; then
          ready="yes"
          break
        fi
        sleep 2
      done
      if [ -n "$ready" ]; then
        echo "ready after about $((i * 2))s"
      else
        echo "never became ready; the container's last log lines follow" >&2
        ssh -o StrictHostKeyChecking=yes "$DEPLOY_USER@$TARGET_HOST" \
          "docker logs --tail 80 '$CONTAINER_NAME'" >&2 || true
        exit 1
      fi

deploy-testing-job:
  <<: *deploy-over-ssh
  stage: deploy-to-testing
  needs: ["build-job"]
  environment:
    name: testing
    url: "$TESTING_URL"
  variables:
    TARGET_HOST: "$TESTING_HOST"
    AWS_SECRET_ID: "$AWS_SECRET_ID_TESTING"
  # needs: alone decides both the order and which artefacts land here — build-job's tarball
  # is the deploy's only input. (If both needs and dependencies are set, needs wins.)
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_COMMIT_TAG'

deploy-final-job:
  <<: *deploy-over-ssh
  # DO NOT RENAME: the compliance framework's deploy-to-prod verification jobs key off this
  # name (docs: tools/gitlab/web-app-tutorial.md, checkpoint 10).
  stage: deploy-to-production
  # `optional: true` because webapp-e2e-job is absent from a tag pipeline (its rules cover
  # the default branch only), and GitLab rejects a needs entry that names no job in the
  # pipeline. The artefact download therefore comes from build-job either way.
  needs:
    - job: build-job
    - job: webapp-e2e-job
      optional: true
  environment:
    name: production
    url: "$PRODUCTION_URL"
  variables:
    TARGET_HOST: "$PRODUCTION_HOST"
    AWS_SECRET_ID: "$AWS_SECRET_ID_PRODUCTION"
  # Manual by design: the gate before a high-stake environment is a person, and IM8's
  # artefact-signature and checksum checks must have passed in the same pipeline. The
  # framework's `verify-job` runs in the `verify` stage of that same pipeline, so a tag
  # deploy keeps the provenance record together.
  when: manual
  allow_failure: false
  rules:
    - if: '$CI_COMMIT_TAG'
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'

# Optional: a rollback is the previous tag, and the previous tag is still in the registry.
# Left out of the pipeline proper because a rollback that nobody has rehearsed is not a
# control. To use it, run it from the UI after filling in $ROLLBACK_REF.
rollback-testing-job:
  <<: *deploy-over-ssh
  stage: deploy-to-testing
  needs: []
  environment:
    name: testing
  variables:
    TARGET_HOST: "$TESTING_HOST"
    AWS_SECRET_ID: "$AWS_SECRET_ID_TESTING"
    IMAGE_REF: "$IMAGE_REGISTRY/$IMAGE_REPOSITORY/$IMAGE_NAME:$ROLLBACK_REF"
  # The job is absent unless someone sets $ROLLBACK_REF, which is the only way to make a
  # manual job safe to leave in a pipeline: an empty tag would otherwise be a red job in
  # every green pipeline, and red-that-means-nothing is how real failures get ignored.
  rules:
    - if: '$ROLLBACK_REF'
      when: manual
      allow_failure: true
