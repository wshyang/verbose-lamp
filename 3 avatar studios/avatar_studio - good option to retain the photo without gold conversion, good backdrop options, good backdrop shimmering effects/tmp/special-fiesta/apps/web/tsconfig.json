{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "paths": {
      "@psd/contracts": ["../../packages/contracts/src/index.ts"],
      "@psd/tournament": ["../../packages/tournament/src/index.ts"],
      "@psd/tournament/*": ["../../packages/tournament/src/*/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tools/**/*.ts", "vite.config.ts"]
}
