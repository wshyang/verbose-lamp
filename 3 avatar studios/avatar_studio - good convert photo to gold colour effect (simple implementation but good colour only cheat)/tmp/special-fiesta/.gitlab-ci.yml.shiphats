# SHIP-HATS pipeline for PSD Active Day — INERT DRAFT.
#
# The extension is deliberate: GitLab only reads `.gitlab-ci.yml`, so this file (and
# BUILD.gitlab-ci.yml.shiphats, TEST.gitlab-ci.yml.shiphats, DEPLOY.gitlab-ci.yml.shiphats)
# describes a pipeline the project does not run yet. Nothing here changes how the app is
# built or tested today; `npm run verify` on a push to GitHub remains the whole gate.
#
# To turn it on, run ./shiphats-activate.sh — it asks for the values that only a human
# knows (the template project, your Nexus repos, the deploy hosts, the runner tags),
# substitutes them, and renames the four files into place. It refuses to overwrite, and
# it never writes a secret into a file: tokens and keys belong in GitLab's Settings →
# CI/CD → Variables, which is where the SHIP-HATS tutorials put them too.
#
# Why exactly these four files: SHIP-HATS's webapp E2E template asks for a repo-root
# `.gitlab-ci.yml` that `include:`s the compliance template plus three local files —
# BUILD (produce $OUTPUT_ARTEFACT), TEST (lint/unit/dependency checks) and DEPLOY
# (`deploy-testing-job`, plus `deploy-final-job` whose name must not change). Source:
# docs.developer.tech.gov.sg/docs/ship-hats-docs/tools/gitlab/web-app-tutorial.md and
# snippets/sample-pipeline.md, read 2026-10-11. The stage names below are the documented
# ones and MUST NOT be renamed — the compliance framework adds jobs into them.
#
# What is NOT verified from here: the four `include:`d template files live in SGTS GitLab
# (`sgts.gitlab-dedicated.com`), which this sandbox cannot reach. Every `CONFIRM:` note
# below is a fact taken from the public SHIP-HATS docs that should be checked against the
# template source once the project is onboarded.

include:
  # CONFIRM: exact project path and ref. Docs: `WOG/GVT/ship` paths became
  # `innersource/sgts/ship-hats`, and templates are now tagged from v1.1.0 onwards.
  # Never include `ref: main` for a pipeline you depend on — a template update would land
  # in your project unpinned.
  - project: "@@SHIPHATS_TEMPLATE_PROJECT@@"
    ref: "@@SHIPHATS_TEMPLATE_REF@@"
    file: ["@@SHIPHATS_TEMPLATE_FILE@@"]
  # These three are ours, and the template expects exactly these names.
  - local: BUILD.gitlab-ci.yml
  - local: TEST.gitlab-ci.yml
  - local: DEPLOY.gitlab-ci.yml

# An MR pipeline runs everything except the deploys; `main` additionally publishes;
# a tag is what gets deployed to production. The compliance framework's `verify-job` and
# `deploy-final-job` sit behind a manual gate, so no rule here needs to guard prod.
workflow:
  rules:
    - if: "$CI_PIPELINE_SOURCE == 'merge_request_event'"
    - if: "$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH"
    - if: "$CI_COMMIT_TAG"

# Every value below is written by shiphats-activate.sh. Secrets are absent by design:
# the pipeline references them by NAME, and their values exist only in GitLab's masked
# and protected CI/CD variables (see the checklist the script prints at the end).
variables:
  # ---- where the artefact is built, and what it is -------------------------------
  # The template builds inside WORKING_DIR and expects one file named OUTPUT_ARTEFACT
  # to sign, scan and publish. For a container app the artefact is the image tarball
  # that Kaniko writes; `docker load` on the host turns it back into a runnable image,
  # so one file serves both the Nexus upload and the deploy.
  WORKING_DIR: "@@WORKING_DIR@@"
  OUTPUT_ARTEFACT: "@@OUTPUT_ARTEFACT@@"
  VERSION: "@@VERSION@@"

  # ---- container image -----------------------------------------------------------
  # This repo builds two images from the same bits (scripts/check-standards.mjs enforces it).
  # Dockerfile is the demo image: PSD_SEED=demo, supervisord + cloudflared, port 8787 (ADR-043).
  # Dockerfile-prd is production: PSD_SEED=default, ONE process under tini, no supervisord, no
  # tunnel, port 3000 (ADR-323). A production pipeline must point at Dockerfile-prd or it ships
  # a seeded demo database. The container must run with a restart policy of always/unless-stopped.
  DOCKERFILE: "@@DOCKERFILE@@"
  IMAGE_REGISTRY: "@@IMAGE_REGISTRY@@"
  IMAGE_REPOSITORY: "@@IMAGE_REPOSITORY@@"
  IMAGE_NAME: "@@IMAGE_NAME@@"
  IMAGE_REF: "$IMAGE_REGISTRY/$IMAGE_REPOSITORY/$IMAGE_NAME:$VERSION-$CI_COMMIT_SHORT_SHA"
  # Set true only after the registry exists and the pull secret is in place.
  PUSH_IMAGE: "@@PUSH_IMAGE@@"

  # ---- runtime readiness ---------------------------------------------------------
  # The compliance framework runs a readiness check after each deploy (template
  # templates/gitlab-ci-check-app-readiness.yml → wait-for-web-app-ready-job). It waits for
  # WEBAPP_URL to answer and searches the response for WEBAPP_NAME. `/api/health` returns
  # {"ok":true} (apps/api/src/app.ts:189), so the text to look for is `ok`.
  PORT: "@@PORT@@"
  WEBAPP_URL: "@@WEBAPP_URL@@"
  WEBAPP_NAME: "@@WEBAPP_NAME@@"
  READINESS_PATH: "@@READINESS_PATH@@"

  # ---- dependency and artefact repositories (Nexus) ------------------------------
  # IM8 requires the artefact to pass through a repository rather than be shipped from the
  # runner. NEXUSREPO_REPO_ID is the hosted repo the tarball is uploaded to; the group id
  # and artefact id form its coordinates.
  NEXUSREPO_REPO_ID: "@@NEXUSREPO_REPO_ID@@"
  NEXUSREPO_REPO_GROUP_ID: "@@NEXUSREPO_REPO_GROUP_ID@@"
  ARTEFACT_ID: "@@ARTEFACT_ID@@"
  ARTEFACT_PACKAGE: "@@ARTEFACT_PACKAGE@@"
  # The Nexus `npm configure` template points npm at a group repo so installs resolve
  # through it. Left empty means the jobs use the default registry — which only works if
  # the runner has egress; on SHIP-HATS shared runners it does not.
  NEXUS_NPM_GROUP_REPO: "@@NEXUS_NPM_GROUP_REPO@@"
  MVN_SETTINGS_FILE: "@@MVN_SETTINGS_FILE@@"
  MAVEN_SETTINGS_SERVER_ID: "@@MAVEN_SETTINGS_SERVER_ID@@"

  # ---- toolchain -----------------------------------------------------------------
  # Versions the jobs run under. Node 22 because that is what the image uses
  # (node:22-alpine); package.json engines say >=20.11, so 22 is the floor that matches
  # production rather than the lowest the manifest tolerates.
  NODE_IMAGE: "@@NODE_IMAGE@@"
  KANIKO_IMAGE: "@@KANIKO_IMAGE@@"
  CRANE_IMAGE: "@@CRANE_IMAGE@@"

  # ---- runners -------------------------------------------------------------------
  # Shared runners are Docker runners; there is no DinD and no privileged runner on the
  # shared pool, which is why the image build uses Kaniko (`ship_docker` is the documented
  # tag for root-capable non-privileged shared runners) and the registry copy uses Crane
  # (`cstack` runners need no root). CONFIRM the tag list with the runners shown in
  # Settings → CI → Runners for this project.
  #
  # Tool versions in the pipeline images should match the platform's integrated versions:
  # docs.developer.tech.gov.sg/docs/ship-hats-docs/tools/gitlab/integrated-tools-version.md

  # ---- security tools ------------------------------------------------------------
  # Flags only. The tokens themselves are GitLab CI/CD variables; if a pair below is
  # switched on without its token the job fails with an authentication error, and if
  # FOD_* / NEXUS_IQ_* are unset the framework substitutes GitLab's native SAST/DAST and
  # dependency scanning instead.
  USE_SONAR: "@@USE_SONAR@@"
  USE_NEXUS_IQ: "@@USE_NEXUS_IQ@@"
  USE_FOD: "@@USE_FOD@@"
  SONAR_PROJECTKEY: "@@SONAR_PROJECTKEY@@"
  FOD_RELEASE: "@@FOD_RELEASE@@"

  # ---- deploy targets ------------------------------------------------------------
  # One container, so "deploy" means: put the tarball on the host, load it, replace the
  # container. TESTING_URL and PRODUCTION_URL are the URLs the e2e job and the DAST scan
  # point at, and they are also what `environment:url` shows in the GitLab UI.
  DEPLOY_STRATEGY: "@@DEPLOY_STRATEGY@@"
  DEPLOY_USER: "@@DEPLOY_USER@@"
  TESTING_HOST: "@@TESTING_HOST@@"
  PRODUCTION_HOST: "@@PRODUCTION_HOST@@"
  REMOTE_IMAGE_DIR: "@@REMOTE_IMAGE_DIR@@"
  CONTAINER_NAME: "@@CONTAINER_NAME@@"
  RUN_OPTS: "@@RUN_OPTS@@"
  REMOTE_ENV_FILE: "@@REMOTE_ENV_FILE@@"
  TESTING_URL: "@@TESTING_URL@@"
  PRODUCTION_URL: "@@PRODUCTION_URL@@"
  # SSH keys are fetched from AWS Secrets Manager through OIDC (the documented
  # templates/gitlab-ci-aws.yml → invoke-awssecretretrieval pattern) rather than stored as
  # CI variables, so no long-lived private key sits in GitLab.
  AWS_REGION: "@@AWS_REGION@@"
  AWS_SECRET_ID_TESTING: "@@AWS_SECRET_ID_TESTING@@"
  AWS_SECRET_ID_PRODUCTION: "@@AWS_SECRET_ID_PRODUCTION@@"
  SSH_KEY_NAME: "@@SSH_KEY_NAME@@"
  # The images the deploy and e2e jobs run in. Both must come from a registry your project
  # controls: the deploy image needs ssh, scp, curl and the AWS CLI; the e2e image needs
  # Node and the Playwright browsers already fetched, because `npm run e2e:install` cannot
  # reach the browser CDN from a shared runner.
  DEPLOY_IMAGE: "@@DEPLOY_IMAGE@@"
  E2E_IMAGE: "@@E2E_IMAGE@@"
  # Empty by design: rollback-testing-job exists only when this is set from the UI, so a
  # pipeline that nobody is rolling back does not carry a job that would fail.
  ROLLBACK_REF: ""

  # ---- Nexus upload --------------------------------------------------------------
  # The publish path is Maven-shaped (the tutorial's Nexus job uploads with mvn
  # deploy:deploy-file), so the upload needs the repository URL as well as its id.
  NEXUS_REPO_URL: "@@NEXUS_REPO_URL@@"

  # ---- e2e -----------------------------------------------------------------------
  # The app's own end-to-end suite is Playwright, not Robot Framework, so the template's
  # Robot slot is replaced by webapp-e2e-job in the runtime-test stage (see below).
  # RF_TESTSCRIPT_FOLDER / OPTS stay here for the day Robot is adopted.
  RF_TESTSCRIPT_FOLDER: "@@RF_TESTSCRIPT_FOLDER@@"
  MAVEN_OPTS: -Dmaven.repo.local=$HOME/.m2/repository

  # ---- read from Settings → CI/CD → Variables, never from this file ---------------
  # COSIGN_PASSWORD, SONAR_TOKEN, FOD_USERNAME, FOD_PAT, NEXUS_IQ_USERNAME,
  # NEXUS_IQ_PASSWORD, NEXUS_IQ_APP_ID, NEXUS_IQ_SCAN_OPTIONS, NEXUS_REPO_USERNAME,
  # NEXUS_REPO_PASSWORD, and DEPLOY_SSH_KEY as the fallback for the AWS secret path. They
  # appear here as names only, so that one file lists every input the pipeline has; a value
  # written here is a secret committed to a repository, which no --revert undoes.
  # config-check-job in TEST.gitlab-ci.yml fails the pipeline early when one is missing.

# The template owns `stages:`. They are documented as planning / development /
# build-and-package / runtime-test / deploy-to-testing / deploy-to-production / verify
# (the compliance framework's own jobs land in .pre and deploy-to-prod). CONFIRM against
# the included template: a job naming a stage that is not in the list fails the whole
# config, which is the usual first pipeline error onboarding produces.

# Everything that is true for every job lives here, so the three local files stay short.
default:
  image: "$NODE_IMAGE"
  cache:
    key:
      files:
        - package-lock.json
    paths:
      - .npm/
    policy: pull-push
  before_script:
    - npm config set cache "$CI_PROJECT_DIR/.npm"
    - npm config fund false
    - |
      if [ -n "$NEXUS_NPM_GROUP_REPO" ]; then
        # Installs must resolve through Nexus on SHIP-HATS runners; the public registry is
        # not reachable from the shared pool.
        npm config set registry "$NEXUS_NPM_GROUP_REPO"
      fi
    # npm ci is deliberately NOT here: the deploy jobs do not need node_modules, and a
    # 4-workspace install in every job is the slowest mistake a Node pipeline makes.
    # The Nexus publish templates are Maven-shaped, so they want a settings.xml with the
    # server credentials in it. One printf, no heredoc: a heredoc inside a GitLab script
    # block loses its terminator to YAML indentation.
    - |
      if [ -n "$MVN_SETTINGS_FILE" ] && [ -n "$NEXUS_REPO_USERNAME" ]; then
        mkdir -p "$(dirname "$MVN_SETTINGS_FILE")"
        printf '<settings><servers><server><id>%s</id><username>%s</username><password>%s</password></server></servers></settings>' \
          "$MAVEN_SETTINGS_SERVER_ID" "$NEXUS_REPO_USERNAME" "$NEXUS_REPO_PASSWORD" > "$MVN_SETTINGS_FILE"
      fi
