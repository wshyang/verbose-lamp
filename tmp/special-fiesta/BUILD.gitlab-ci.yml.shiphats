# BUILD — the `build-and-package` stage of the SHIP-HATS pipeline. INERT DRAFT.
#
# Contract this file has to satisfy: the webapp E2E template's BUILD.gitlab-ci.yml must
# leave one file named $OUTPUT_ARTEFACT in $WORKING_DIR, because that file is what the
# compliance framework then signs, scans, verifies and publishes (docs:
# tools/gitlab/web-app-tutorial.md, "build-job"). Everything else here is this repo's
# own shape: one Dockerfile, one image, no zip of a bundle.
#
# Source: docs.developer.tech.gov.sg/docs/ship-hats-docs/, read 2026-10-11.
# CONFIRM: the kaniko/crane image references must be your Nexus-docker-proxied copies —
# the shared runners have no general internet egress, so a `gcr.io/...` reference is a
# placeholder for wherever your project mirrors it.

# Kaniko, not `docker build`: SHIP-HATS shared runners do not offer Docker-in-Docker or
# privileged runners (docs: snippets/runner-faqs.md — "SHIP-HATS does not support
# Docker-in-Docker (dind) or privileged shared runners").
build-job:
  stage: build-and-package
  needs: []
  image:
    name: "$KANIKO_IMAGE"
    entrypoint: [""]
  # The root default's before_script configures npm, and there is no npm in this image. A job
  # replaces rather than appends to a default, so the opt-out has to be one real command — and
  # GitLab will not take an empty before_script. The image build needs no install at all: the
  # Dockerfile installs inside itself.
  before_script:
    - "true"
  tags:
    - "@@RUNNER_TAG_BUILD@@"
  variables:
    GIT_STRATEGY: fetch
  script:
    - mkdir -p "$CI_PROJECT_DIR/$WORKING_DIR"
    - |
      mkdir -p /kaniko/.docker
      printf '{"auths":{"%s":{"auth":"%s"}}}' "$IMAGE_REGISTRY" \
        "$(printf '%s:%s' "$CI_REGISTRY_USER" "$CI_REGISTRY_PASSWORD" | base64 | tr -d '\n')" \
        > /kaniko/.docker/config.json
    # --no-push plus --tarPath is the whole trick: the same tarball is the artefact the
    # pipeline signs and the image the host loads. --destination still has to be given,
    # because the label and the tar's repo tag are taken from it.
    - |
      # Layer caching writes to a registry, so it is only on when pushing is on: a Kaniko run
      # that cannot write its cache repo fails on the cache push rather than on the build, and
      # on an MR pipeline the cache repo is the one thing that may not exist yet.
      cache_args=""
      if [ "$PUSH_IMAGE" = "true" ]; then
        cache_args="--cache=true --cache-repo $IMAGE_REGISTRY/$IMAGE_REPOSITORY/$IMAGE_NAME-cache"
      fi
      /kaniko/executor \
        --context "$CI_PROJECT_DIR/$WORKING_DIR" \
        --dockerfile "$CI_PROJECT_DIR/$DOCKERFILE" \
        --destination "$IMAGE_REF" \
        --tarPath "$CI_PROJECT_DIR/$WORKING_DIR/$OUTPUT_ARTEFACT" \
        --no-push \
        $cache_args \
        --label "org.opencontainers.image.revision=$CI_COMMIT_SHA" \
        --label "org.opencontainers.image.source=$CI_PROJECT_URL" \
        --label "org.opencontainers.image.version=$VERSION"
    # Checksum next to the artefact. This file holds the hex digest alone — the deploy job
    # rebuilds the two-field `sha512sum -c` form on the far side. CONFIRM: the framework's
    # checksum-verify template may want "<digest>  <filename>" in the uploaded file instead;
    # if so, drop the awk and let sha512sum print both fields.
    - |
      cd "$CI_PROJECT_DIR/$WORKING_DIR"
      sha512sum "$OUTPUT_ARTEFACT" | awk '{print $1}' > "$OUTPUT_ARTEFACT.sha512"
      ls -lh "$OUTPUT_ARTEFACT" "$OUTPUT_ARTEFACT.sha512"
    # The image is only loadable if the tarball survived the runner -> artefact -> Nexus
    # round trip, so prove the archive is readable here rather than on the deploy host.
    - |
      cd "$CI_PROJECT_DIR/$WORKING_DIR"
      tar -tf "$OUTPUT_ARTEFACT" | head -5
  artifacts:
    name: "$CI_COMMIT_SHORT_SHA-artefact"
    # GitLab does not expand CI variables in artifacts:paths, so the artefact name is
    # written into this file by shiphats-activate.sh instead of referenced. That also means
    # WORKING_DIR has to stay at the repo root for this layout — the activator checks it.
    paths:
      - "@@OUTPUT_ARTEFACT@@"
      - "@@OUTPUT_ARTEFACT@@.sha512"
    expire_in: "1 month"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH || $CI_COMMIT_TAG'

# A tarball is not a deployment target until something turns it into a pullable image.
# Crane (go-containerregistry) is used instead of `docker push` because it runs on
# non-privileged, non-root runners — the SHIP-HATS runner FAQ names Skopeo and Crane for
# exactly that case (`cstack` runners).
image-push-job:
  stage: build-and-package
  needs: ["build-job"]
  image:
    name: "$CRANE_IMAGE"
    entrypoint: [""]
  before_script:
    - "true"
  tags:
    - "@@RUNNER_TAG_PUSH@@"
  script:
    - |
      # --password-stdin rather than -p: a command line is readable in `ps` output, which a
      # busy shared runner writes into logs people share.
      printf '%s' "$CI_REGISTRY_PASSWORD" \
        | crane auth login "$IMAGE_REGISTRY" -u "$CI_REGISTRY_USER" --password-stdin
      crane push "$CI_PROJECT_DIR/$WORKING_DIR/$OUTPUT_ARTEFACT" "$IMAGE_REF"
      crane digest "$IMAGE_REF" | tee "$CI_PROJECT_DIR/$WORKING_DIR/$OUTPUT_ARTEFACT.digest"
      echo "pushed $IMAGE_REF"
  artifacts:
    paths:
      - "@@OUTPUT_ARTEFACT@@.digest"
    expire_in: "1 month"
  rules:
    - if: '$PUSH_IMAGE == "true"'

# Node's dependency tree is what Nexus IQ and the SCA controls look at, and the
# lockfile is the record of it. Publishing the lockfile beside the image gives the
# provenance record something a reviewer can actually re-resolve.
# (templates/gitlab-ci-publish-to-nexus.yml covers nodejs artefacts; this job is the
# fallback for when that template is not included.)
publish-lockfile-job:
  stage: build-and-package
  needs: ["build-job"]
  tags:
    - "@@RUNNER_TAG_TOOLING@@"
  script:
    - |
      if [ -z "$MVN_SETTINGS_FILE" ] || [ ! -f "$MVN_SETTINGS_FILE" ]; then
        echo "MVN_SETTINGS_FILE not present — is NEXUS_REPO_USERNAME/…_PASSWORD set in"
        echo "Settings → CI/CD → Variables? This job cannot upload without it." >&2
        exit 1
      fi
    - |
      mvn deploy:deploy-file \
        -s "$MVN_SETTINGS_FILE" \
        -DrepositoryId="$MAVEN_SETTINGS_SERVER_ID" \
        -Durl="$NEXUS_REPO_URL" \
        -DgroupId="$NEXUSREPO_REPO_GROUP_ID" \
        -DartifactId="$ARTEFACT_ID-dependencies" \
        -Dversion="$VERSION-$CI_COMMIT_SHORT_SHA" \
        -Dpackaging=json \
        -Dfile=package-lock.json \
        -DgeneratePom=true
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      when: on_success
