node_modules/
dist/
build/
coverage/

# Local PGlite data directory — a database, not source.
.data/

# Runtime state for the dev-stack scripts (./dev.sh): pidfile, process group, log.
.dev/

# Real secrets. .env.example and .env.test are committed; .env is not.
.env
.env.local
.env.*.local

# Test artefacts
test-results/
test-results-full-event/
test-results-tessensohn/
test-results-dress-rehearsal/
test-results-scale/
test-results-load/
playwright-report/
blob-report/
.playwright/
# Screenshots a suite captures are run artifacts like the rest of this group: they regenerate from
# the spec that took them, and a picture of a passing test is not evidence that it passed.
screenshots/

# The photoreal renders the scene layers are keyed from (ADR-193). Scratch input, not source:
# ~1.6 MB apiece, never read at run time, and regenerating a layer means regenerating the render
# anyway. The reproducible artefact is the PROMPT, which is recorded in the ADR beside the layer.
.scene-src/

# Reference photographs pulled in for landmark verification. They also break `git checkout` after
# a reset if left in the tree, because the tool writes them to the repository root.
image-search/

# Editor / OS noise
.DS_Store
*.log
.vscode/
.idea/

# AI staging output for test photos: the normalised copies in images/ingest are the source.
images/raw-social/

# ADR-193 — the photoreal scene's flattened review composite, regenerated on demand.
apps/web/public/themes/sentosa/scene-real/_preview.png
apps/web/public/themes/sentosa/scene-real/_preview.html

# Generic heartland scene composition review output (regenerated by
# apps/web/scripts/scene/generate-generic-composition.mjs from .scene-src/).
apps/web/public/themes/generic/scene-composition/
