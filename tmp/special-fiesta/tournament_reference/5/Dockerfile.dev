# Cloud-development image (GREENFIELD s10.1, adapted from initial-templates).
# Where the platform supplies a VIPER agent it is mounted at runtime; the dev
# server below is configured for a forwarded HTTPS host name.
FROM node:22.14.0-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --ignore-scripts
COPY . .
RUN addgroup -g 1001 -S app && adduser -S -u 1001 -G app app && chown -R app:app /app
ENV HOST=0.0.0.0
ENV PORT=3000
ENV VIPER_APP_PORT=3001
EXPOSE 3000
USER 1001
CMD ["sh", "-c", "npm run build && npm start"]
