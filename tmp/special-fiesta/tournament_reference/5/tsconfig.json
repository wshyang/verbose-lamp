{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": false,
    "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"], "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["shared", "backend", "frontend/src"]
}
