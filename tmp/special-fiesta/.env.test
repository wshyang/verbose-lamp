# Committed on purpose: the integration suite must run identically on every machine and in CI.
# These values touch an in-memory PGlite database only (apps/api/src/tests/harness.ts).
NODE_ENV=test
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=memory://
SUPERADMIN_INITIAL_USERNAME=superadmin
SUPERADMIN_INITIAL_PASSCODE=4242
SESSION_TTL_DAYS=1
COOKIE_SECURE=false
