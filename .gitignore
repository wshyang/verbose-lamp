.DS_Store

# Installed dependencies. `node_modules/` was committed during the initial import
# (10 066 tracked files) and is left tracked for now: untracking it is a mechanical
# change bigger than this round's budget. New installs are ignored from here on, so
# `npm install` no longer dirties the index (ADDENDUM-025 §6).
node_modules/

# Build and test output
dist/
# Production build served as a sandbox preview; the tracked artefact is dist/index.html
dist-preview/
coverage/
# Per-run JSON used for line-level triage (ADDENDUM-028 §1)
coverage-json/
coverage-summary/
test-results/
playwright-report/
blob-report/
.vite/
*.tsbuildinfo

# Vitest's own cache
.vitest-cache/

# Playwright's browser download lives outside the repo (~/.cache/ms-playwright).
# `scripts/sandbox-browser.mjs` extracts its Chromium to /tmp for the same reason.
